PORT=3000

# Agent -> Backend auth
AGENT_API_KEY=replace-with-strong-api-key
AGENT_HMAC_SECRET=replace-with-strong-hmac-secret
# 비우면 agentId 제한 없음. 값이 있으면 payload.agentId와 일치할 때만 허용(siteId는 검사 안 함).
ALLOWED_AGENT_ID=field-pc-001

# Neon/Render Postgres 커넥션 문자열(SSL 필요 시 ?sslmode=require 포함)
DATABASE_URL=replace-with-neon-or-render-external-database-url

# JWT (사람 경계)
JWT_SECRET=replace-with-strong-jwt-secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=https://replace-with-frontend-domain
