PORT=3000

# Agent -> Backend auth (기계 경계: x-api-key + HMAC-SHA256)
AGENT_API_KEY=replace-with-strong-api-key
AGENT_HMAC_SECRET=replace-with-strong-hmac-secret

# 선택: 비우면 어떤 agentId도 허용(API 키·HMAC만 맞으면 됨).
# 값을 넣으면 요청 JSON의 agentId가 이 문자열과 정확히 같을 때만 허용(다중 현장 PC는 비우거나 agentId를 통일).
# 참고: siteId는 별도 화이트리스트 없음 — 구분·통계용으로만 저장됨.
ALLOWED_AGENT_ID=field-pc-001

# Postgres (Neon 프로덕션 / 로컬은 docker-compose Postgres). SQLite 듀얼모드는 제거됨.
DATABASE_URL=postgresql://user:password@localhost:5432/sitescope

# JWT (사람 경계: Passport-JWT 대시보드 로그인)
JWT_SECRET=replace-with-strong-jwt-secret
JWT_EXPIRES_IN=1d

# 프론트 오리진만 CORS 허용
CORS_ORIGIN=http://localhost:5173
